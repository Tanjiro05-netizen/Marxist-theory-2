# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
# Use the legacy service_role key (or a compatible server secret key) from
# Supabase Dashboard -> Project Settings -> API Keys.
SUPABASE_SERVICE_ROLE_KEY=

# Public feature switches
NEXT_PUBLIC_MAINTENANCE_MODE=true
# The production build exposes /submit only when this is exactly "true".
SUBMISSIONS_ENABLED=false

# Allows production to accept PDFs into the private quarantine while a local
# scanner is offline. Unscanned files stay locked and cannot be previewed,
# downloaded, approved, or published.
ALLOW_QUARANTINED_SUBMISSIONS=false

# Cloudflare Turnstile (free bot protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Long random value used only to hash IPs for abuse-rate limiting. It is not
# stored in the browser or database. Example: openssl rand -hex 32
SUBMISSION_IP_HASH_SECRET=

# Private PDF malware/CDR scanner. See services/document-scanner/README.md.
# Optional when ALLOW_QUARANTINED_SUBMISSIONS=true. If this service is omitted or
# offline, submissions remain locked until the local worker processes them.
DOCUMENT_SCANNER_URL=
DOCUMENT_SCANNER_TOKEN=
DOCUMENT_SCANNER_TIMEOUT_MS=45000
# The scanner defaults to the same 50 MB maximum as the application.

# Optional: private Cloudflare R2 storage for submitted manuscripts.
# When these are omitted, submissions continue using Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_SUBMISSIONS_BUCKET=manuscript-submissions

# Local scanner worker settings (server-only; never add NEXT_PUBLIC_ prefixes).
# The worker uses the Supabase URL and service-role key above.
SUBMISSION_SCANNER_POLL_MS=60000
SUBMISSION_SCANNER_MAX_ATTEMPTS=5
